{
  "name": "tracebook",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Sandro Pasquali",
    "email": "spasquali@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandro-pasquali/tracebook.git"
  },
  "bugs": {
    "url": "https://github.com/sandro-pasquali/tracebook/issues"
  },
  "homepage": "https://github.com/sandro-pasquali/tracebook#readme",
  "type": "module",
  "packageManager": "yarn@4.16.0+sha512.5374c94eb4ef6aa8188fb112f20c1aa6569f248d676c5e576e1fd2a1a4d8d87a96df65d9dfe1c2a0252cbe38bda46cf18d955005b81b43cc7607a5c9d56fd2b6",
  "description": "Source-grounded product stories for understanding and changing software with LLMs.",
  "engines": {
    "node": ">=24.0.0"
  },
  "resolutions": {
    "sharp@npm:^0.34.1": "portal:./vendor/sharp-text-only"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-models-dir.js",
    "dev": "vite",
    "build:client": "vite build --mode client",
    "build:server": "vite build",
    "build": "yarn build:client && yarn build:server",
    "preview": "vite build --mode client && vite build && node dist/index.js",
    "test": "node --import ./test/setup-env.js --test test/**/*.test.js",
    "test:unit": "node --import ./test/setup-env.js --test test/unit/*.test.js",
    "test:functional": "node --import ./test/setup-env.js --test test/functional/*.test.js",
    "test:integration": "node --import ./test/setup-env.js --test test/integration/*.test.js",
    "test:e2e": "node --import ./test/setup-env.js --test test/e2e/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov node --import ./test/setup-env.js --test test/**/*.test.js",
    "eval:retrieval": "node --import ./test/setup-env.js test/eval/retrieval-eval.js",
    "eval:retrieval:compare": "node --import ./test/setup-env.js test/eval/retrieval-eval.js --compare-expansion",
    "eval:generation": "node test/eval/generation-eval.js",
    "eval:generation:judge": "node test/eval/generation-eval.js --judge",
    "eval:generation:reasoning": "node test/eval/generation-eval.js --reasoning-probe",
    "eval:generation:overview": "node test/eval/generation-eval.js --overview-probe",
    "docs:screenshots": "yarn build:client && node scripts/capture-product-walkthrough.js",
    "eval:baseline": "node scripts/eval-matrix.js --save-baseline",
    "eval:check": "node scripts/eval-matrix.js --compare",
    "eval:promote": "node scripts/eval-matrix.js --promote",
    "eval:smoke": "node scripts/eval-smoke.js",
    "eval:generation:fast": "EVAL_BASELINE_NAME=tracebook-fast EVAL_INDEX_DIR=.eval-cache/tracebook-fast node --import ./test/eval/setup-fast-env.js test/eval/generation-eval.js",
    "test:browser": "yarn build:client && node bin/test-browser.js",
    "lint": "xo",
    "verify": "yarn lint && yarn test && yarn build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": "xo --fix"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/runner": "^5.3.0",
    "c8": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "playwright": "^1.60.0",
    "vite": "^7.3.6",
    "xo": "^2.0.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/mistral": "^3.0.37",
    "@ai-sdk/openai": "^3.0.65",
    "@bandf/code-image": "1.2.0",
    "@hono/node-server": "^2.1.1",
    "@huggingface/transformers": "^3.0.0",
    "@lancedb/lancedb": "^0.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "ai": "^6.0.191",
    "ai-sdk-ollama": "^3",
    "apache-arrow": "18.1.0",
    "chokidar": "^5.0.0",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.3",
    "ignore": "^7.0.5",
    "marked": "^18.0.4",
    "mermaid": "^11.17.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.20.8",
    "zod": "^4.4.3"
  }
}
